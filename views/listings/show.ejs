<% layout('/layouts/boilerplate') %>

<%
    const USD_TO_INR = 83;
    const toInr = (usdValue) => Math.round(Number(usdValue || 0) * USD_TO_INR);
    const reviewCount = listing.reviews.length;

    const ratedReviews = listing.reviews.filter(
        review => Number(review.rating) > 0
    );

    const ratingSum = ratedReviews.reduce(
        (sum, review) => sum + Number(review.rating),
        0
    );

    const averageRating = ratedReviews.length
        ? (ratingSum / ratedReviews.length).toFixed(1)
        : (listing.rating ? Number(listing.rating).toFixed(1) : "New");
%>

<section class="show-shell">
    <div class="show-bg-shape show-bg-shape-one"></div>
    <div class="show-bg-shape show-bg-shape-two"></div>

    <div class="container py-5 show-wrap">

        <!-- LISTING -->
        <article class="show-main-card">

            <div class="show-media-wrap">
                <img
                    src="<%= listing.image.url %>"
                    alt="Image of <%= listing.title %>"
                    class="show-media"
                >
            </div>

            <div class="show-content">

                <div class="show-headline-row">

                    <span class="show-owner-pill">
                        <i class="fa-regular fa-user"></i>
                        Hosted by <%= listing.owner?.username || "Host" %>
                    </span>

                    <span class="show-rating-pill">
                        <i class="fa-solid fa-star"></i>
                        <%= averageRating %>
                        (<%= reviewCount %>)
                    </span>

                </div>

                <h1 class="show-title">
                    <%= listing.title %>
                </h1>

                <p class="show-description">
                    <%= listing.description %>
                </p>

                <div class="show-meta-grid">

                    <div class="show-meta-item">
                        <p class="show-meta-label">Price</p>
                        <p class="show-meta-value">
                            ₹<%= toInr(listing.price).toLocaleString("en-IN") %> / night
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Location</p>
                        <p class="show-meta-value">
                            <%= listing.location %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Country</p>
                        <p class="show-meta-value">
                            <%= listing.country %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Property Type</p>
                        <p class="show-meta-value">
                            <%= listing.propertyType || "Not specified" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Room Type</p>
                        <p class="show-meta-value">
                            <%= listing.roomType || "Not specified" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Guests</p>
                        <p class="show-meta-value">
                            <%= listing.guests ?? "-" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Bedrooms</p>
                        <p class="show-meta-value">
                            <%= listing.bedrooms ?? "-" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Beds</p>
                        <p class="show-meta-value">
                            <%= listing.beds ?? "-" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Bathrooms</p>
                        <p class="show-meta-value">
                            <%= listing.bathrooms ?? "-" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Booking</p>
                        <p class="show-meta-value">
                            Min <%= listing.minimumNights || 1 %> night<%= (listing.minimumNights || 1) === 1 ? "" : "s" %>
                            <% if (listing.maximumNights) { %>
                                , Max <%= listing.maximumNights %> nights
                            <% } %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Availability</p>
                        <p class="show-meta-value">
                            <%= listing.availability30 ?? "-" %>/30 days, <%= listing.availability365 ?? "-" %>/365 days
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Instant Book</p>
                        <p class="show-meta-value">
                            <%= listing.instantBookable ? "Available" : "Not available" %>
                        </p>
                    </div>

                    <div class="show-meta-item">
                        <p class="show-meta-label">Host</p>
                        <p class="show-meta-value">
                            <%= listing.host?.name || listing.owner?.username || "Host" %>
                            <% if (listing.host?.isSuperhost) { %>
                                (Superhost)
                            <% } %>
                            <% if (listing.host?.responseRate) { %>
                                - Response rate: <%= listing.host.responseRate %>
                            <% } %>
                        </p>
                    </div>

                    <div class="show-meta-item" style="grid-column: 1 / -1;">
                        <p class="show-meta-label">Amenities</p>
                        <p class="show-meta-value">
                            <%= listing.amenities?.length ? listing.amenities.join(", ") : "Not specified" %>
                        </p>
                    </div>

                </div>

                <% if (currUser && listing.owner?._id.equals(currUser._id)) { %>

                    <div class="show-owner-actions">

                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="btn show-btn-edit"
                        >
                            Edit Listing
                        </a>

                        <form
                            method="POST"
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            onsubmit="return confirm('Are you sure you want to delete this listing?');"
                        >
                            <button
                                type="submit"
                                class="btn show-btn-delete"
                            >
                                Delete Listing
                            </button>
                        </form>

                    </div>

                <% } %>

            </div>

        </article>


        <!-- MAP -->

        <div class="show-map-card mt-4">

            <h3 class="show-review-title">
                Where you'll stay
            </h3>

            <p class="show-review-subtitle">
                <%= listing.location %>, <%= listing.country %>
            </p>

            <div id="map"></div>

        </div>

        <script>
            window.listingCoordinates =
                <%- JSON.stringify(listing.geometry?.coordinates || null) %>;

            window.listingTitle =
                <%- JSON.stringify(listing.title) %>;
        </script>


        <!-- REVIEWS -->

        <section class="show-review-layout mt-4">

            <!-- REVIEW FORM -->

            <div class="show-review-form-col">

                <% if (currUser) { %>

                    <div class="show-review-card">

                        <h3 class="show-review-title">
                            Leave a Review
                        </h3>

                        <p class="show-review-subtitle">
                            Share your stay experience to help other guests decide better.
                        </p>

                        <form
                            action="/listings/<%- listing._id %>/reviews"
                            method="post"
                            novalidate
                            class="needs-validation"
                        >

                            <div class="mb-3">

                                <label
                                    for="rating"
                                    class="form-label show-form-label"
                                >
                                    Rating
                                </label>

                                <fieldset class="starability-slot">

                                    <input
                                        type="radio"
                                        id="no-rate"
                                        class="input-no-rate"
                                        name="review[rating]"
                                        value="1"
                                        checked
                                        aria-label="No rating."
                                    />

                                    <input
                                        type="radio"
                                        id="first-rate1"
                                        name="review[rating]"
                                        value="1"
                                    />

                                    <label
                                        for="first-rate1"
                                        title="Terrible"
                                    >
                                        1 star
                                    </label>

                                    <input
                                        type="radio"
                                        id="first-rate2"
                                        name="review[rating]"
                                        value="2"
                                    />

                                    <label
                                        for="first-rate2"
                                        title="Not good"
                                    >
                                        2 stars
                                    </label>

                                    <input
                                        type="radio"
                                        id="first-rate3"
                                        name="review[rating]"
                                        value="3"
                                    />

                                    <label
                                        for="first-rate3"
                                        title="Average"
                                    >
                                        3 stars
                                    </label>

                                    <input
                                        type="radio"
                                        id="first-rate4"
                                        name="review[rating]"
                                        value="4"
                                    />

                                    <label
                                        for="first-rate4"
                                        title="Very good"
                                    >
                                        4 stars
                                    </label>

                                    <input
                                        type="radio"
                                        id="first-rate5"
                                        name="review[rating]"
                                        value="5"
                                    />

                                    <label
                                        for="first-rate5"
                                        title="Amazing"
                                    >
                                        5 stars
                                    </label>

                                </fieldset>

                            </div>


                            <div class="mb-4">

                                <label
                                    for="comment"
                                    class="form-label show-form-label"
                                >
                                    Comments
                                </label>

                                <textarea
                                    name="review[comment]"
                                    class="form-control show-review-input"
                                    id="comment"
                                    rows="4"
                                    required
                                ></textarea>

                                <div class="invalid-feedback">
                                    Please add some comments for review.
                                </div>

                            </div>


                            <button
                                class="btn show-review-submit w-100"
                            >
                                Submit Review
                            </button>

                        </form>

                    </div>

                <% } else { %>

                    <div class="show-review-card">

                        <h3 class="show-review-title">
                            Join the conversation
                        </h3>

                        <p class="show-review-subtitle">
                            Log in to add your review and rating for this listing.
                        </p>

                        <a
                            href="/login"
                            class="btn show-review-submit w-100"
                        >
                            Log In to Review
                        </a>

                    </div>

                <% } %>

            </div>


            <!-- REVIEW LIST -->

            <div class="show-reviews-col">

                <div class="show-review-card">

                    <h3 class="show-review-title">
                        Guest Reviews
                    </h3>

                    <p class="show-review-subtitle">

                        <%= reviewCount %>
                        review<%= reviewCount === 1 ? "" : "s" %>
                        shared by the community.

                    </p>


                    <% if (reviewCount) { %>

                        <div class="row g-3">

                            <% for (let review of listing.reviews) { %>

                                <div class="col-md-6">

                                    <article class="show-review-item h-100">

                                        <div class="show-review-item-head">

                                            <p class="show-review-author">

                                                <%= review.reviewerName ||
                                                    review.author?.username ||
                                                    "Guest" %>

                                            </p>


                                            <% if (review.rating) { %>

                                                <p
                                                    class="starability-result"
                                                    data-rating="<%= review.rating %>"
                                                ></p>

                                            <% } else { %>

                                                <p class="show-review-date">

                                                    <%= review.createdAt
                                                        ? new Date(review.createdAt).toLocaleDateString()
                                                        : "" %>

                                                </p>

                                            <% } %>

                                        </div>


                                        <p class="show-review-comment">
                                            <%= review.comment %>
                                        </p>


                                        <!-- Delete only real CheckInly user reviews -->

                                        <% if (
                                            currUser &&
                                            review.author &&
                                            review.author._id.equals(currUser._id)
                                        ) { %>

                                            <form
                                                method="POST"
                                                action="/listings/<%- listing.id %>/reviews/<%- review.id %>?_method=DELETE"
                                            >

                                                <button
                                                    class="btn btn-sm show-review-delete"
                                                    type="submit"
                                                    title="Delete Review"
                                                >
                                                    Delete
                                                </button>

                                            </form>

                                        <% } %>

                                    </article>

                                </div>

                            <% } %>

                        </div>

                    <% } else { %>

                        <div class="show-empty-review">

                            <i class="fa-regular fa-message"></i>

                            <p>
                                No reviews yet. Be the first to share your experience.
                            </p>

                        </div>

                    <% } %>

                </div>

            </div>

        </section>

    </div>
</section>