<% if ((success && success.length) || (error && error.length)) { %>
  <div class="ck-flash-stack" aria-live="polite" aria-atomic="true">
    <% if (success && success.length) { %>
      <div id="flash-success" class="alert alert-dismissible fade show ck-flash ck-flash-success" role="alert">
        <span class="ck-flash-icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="ck-flash-content">
          <p class="ck-flash-title">Success</p>
          <p class="ck-flash-message"><%= success %></p>
        </div>
        <button type="button" class="btn-close ck-flash-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (error && error.length) { %>
      <div id="flash-error" class="alert alert-dismissible fade show ck-flash ck-flash-error" role="alert">
        <span class="ck-flash-icon"><i class="fa-solid fa-circle-exclamation"></i></span>
        <div class="ck-flash-content">
          <p class="ck-flash-title">Something went wrong</p>
          <p class="ck-flash-message"><%= error %></p>
        </div>
        <button type="button" class="btn-close ck-flash-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
  </div>

  <script>
    setTimeout(() => {
      document.querySelectorAll('.ck-flash').forEach((alertEl) => {
        const instance = bootstrap.Alert.getOrCreateInstance(alertEl);
        instance.close();
      });
    }, 5000);
  </script>
<% } %>
